# =====================================================
# Application Configuration
# =====================================================
spring.application.name=Internship Placement Portal
server.port=8080


# =====================================================
# Database Configuration (PostgreSQL)
# =====================================================
spring.datasource.url=jdbc:postgresql://localhost:5432/internship_portal1
spring.datasource.username=postgres
spring.datasource.password=${DB_PASSWORD:postgres}
spring.datasource.driver-class-name=org.postgresql.Driver


# =====================================================
# JPA / Hibernate Configuration
# =====================================================
# update for local dev, validate for prod
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect


# =====================================================
# JWT Configuration (SECURE + STABLE)
# =====================================================
# Read from env if present, otherwise use fallback (LOCAL DEV SAFE)
# Renamed to avoid environment variable conflict (JWT_SECRET)
app.jwt-unique-secret=Yn2kjibddFAWtnPJ2AFlL8WXmohJMCvigQggaEypa5E=
jwt.expiration=${JWT_EXPIRATION:86400000}
jwt.refresh-expiration=${JWT_REFRESH_EXPIRATION:604800000}


# =====================================================
# CORS Configuration (Frontend Integration)
# =====================================================
cors.allowed-origins=http://localhost:3000
cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS,PATCH
cors.allowed-headers=*
cors.allow-credentials=true
cors.max-age=3600


# =====================================================
# Swagger / OpenAPI Configuration
# =====================================================
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.enabled=true


# =====================================================
# Backend URL
# =====================================================
app.backend.url=http://localhost:8080


# =====================================================
# File Upload Configuration
# =====================================================
file.upload.resume-dir=./uploads/resumes
file.upload.profile-dir=./uploads/profiles


# =====================================================
# Logging (debug security during dev)
# =====================================================
logging.level.org.springframework.security=DEBUG
